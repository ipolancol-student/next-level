# Copia este archivo como ".env.local" y cambia la URL por la de tu WordPress.
# Sin barra "/" al final.
#
# WordPress Studio suele usar http://localhost:8881 (o 8882, 8883...).
# LocalWP usa algo como http://mi-tienda.local
WP_URL=http://localhost:8881

# (Opcional) Quetzales por 1 US$ si el Banco de Guatemala no responde. Por defecto 7.7
# TIPO_CAMBIO_RESPALDO=7.7
